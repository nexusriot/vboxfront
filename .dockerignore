# Keep the build context to the sources the image actually copies: a fat
# context is uploaded to the daemon on every build, and none of this is.
.git/
.github/
.idea/
.venv/
.vscode/
build/
dist/
**/__pycache__/
**/*.py[cod]
*.deb

# Runtime image backups/trash can be large and never belong in a build context.
**/.vboxfront-trash/
**/*.vboxfront-backup-*
**/*.vboxfront-partial-*
*.spec.bak
**/.DS_Store
**/Thumbs.db
